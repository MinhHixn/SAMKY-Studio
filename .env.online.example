# Copy to .env.online, then replace the placeholders.
LLM_API_KEY=replace-with-provider-key
LLM_BASE_URL=https://your-openai-compatible-provider.example/v1
LLM_MODEL_NAME=provider/model-id

# OASIS uses the same generation endpoint.
OPENAI_API_KEY=replace-with-provider-key
OPENAI_API_BASE_URL=https://your-openai-compatible-provider.example/v1

# Embeddings stay inside the companion Ollama container.
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_BASE_URL=http://ollama:11434

NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-this-password

HEADLESS_MODE=false
OASIS_DEFAULT_MAX_ROUNDS=60
FLASK_DEBUG=false
